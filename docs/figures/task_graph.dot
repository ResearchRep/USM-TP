digraph G {
    rankdir="BT"
    C [label=<<B>CPU Part.</B>> color="gray" style="filled" group="c"]
    G [label=<<B>GPU Part.</B>> group="g"]
    P [label="Prev." group="g"]
    N [label="Next" group="g"]

    LG [label=<<B>GPU Part.<br/>Launch</B>> style="filled" color="gray" group="c"]
    LN [label="Next\nLaunch" style="filled" color="gray" group="c"]

    LN -> C
    C -> LG
    LG -> P

    G -> LG
    N -> LN

    N -> G [color="transparent"]
    G -> P [color="transparent"]
}
